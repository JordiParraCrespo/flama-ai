+export interface RenameApiTokenVariables {
+  id: string;
+  name: string;
+}
+
+/**
+ * Rename a token. The saved row is written into the token list where it sits;
+ * the permission catalog and the current credential do not depend on a
+ * token's name, so they are left alone.
+ */
+export function useRenameApiToken(
+  options?: HookMutationOptions<ApiTokenEntity, Error, RenameApiTokenVariables>,
+) {
+  const app = useConsumerApp();
+  const queryClient = useQueryClient();
+
+  return useMutation({
+    mutationFn: ({ id, name }: RenameApiTokenVariables) => app.apiTokens.rename(id, name),
+    ...withCacheOnSuccess(options, (token) => {
+      queryClient.setQueryData<ApiTokenEntity[]>(apiTokensKeys.list(), (current) =>
+        current?.map((row) => (row.id === token.id ? token : row)),
+      );
+    }),
+  });
+}
