{
  "$comment": "Read by scripts/starter/prune.mjs, scripts/plugins/plugin.mjs and pnpm starter:init. Every optional piece of the starter is a feature here; the paths are what goes when it is dropped, and every other place that mentions it is wrapped in `flama:begin <id>` / `flama:end <id>` markers. `pnpm starter:check` (CI) fails when a feature is referenced outside its paths and markers, so this file cannot go stale silently. A `json` edit's `set` value is a copy of the file it edits — the version an install writes back — so bumping that dependency means bumping it here too; `starter:check` names both values until they agree.",
  "features": {
    "web": {
      "title": "Consumer web app",
      "summary": "apps/web — Vite + TanStack Router SPA for end users",
      "identifiers": ["apps/web", "@flama/web", "flama-web"],
      "paths": [
        "apps/web",
        "e2e/tests/web",
        "helm/flama/templates/web-deployment.yaml",
        ".agents/skills/shadcn/evals/evals.json",
        ".agents/skills/scaffold-feature/evals"
      ]
    },
    "mobile": {
      "title": "Consumer mobile app",
      "summary": "apps/mobile — Expo app for end users (NativeWind, expo-router)",
      "identifiers": ["apps/mobile", "@flama/mobile"],
      "paths": ["apps/mobile"]
    },
    "web-showcase": {
      "title": "Web design-system showcase",
      "summary": "apps/web-showcase — Next.js gallery of @flama/design-system-web",
      "identifiers": ["apps/web-showcase", "@flama/web-showcase"],
      "paths": [
        "apps/web-showcase",
        ".agents/skills/design-export-port",
        ".agents/skills/next-best-practices",
        ".agents/skills/next-cache-components",
        ".agents/skills/next-upgrade",
        "packages/tsconfig/tsconfig.nextjs.json"
      ],
      "json": [
        {
          "file": "turbo.json",
          "path": ["tasks", "build", "outputs"],
          "remove": [".next/**", "!.next/cache/**"]
        },
        {
          "file": "biome.json",
          "path": ["files", "includes"],
          "remove": ["!**/.next"]
        }
      ]
    },
    "mobile-showcase": {
      "title": "Mobile design-system showcase",
      "summary": "apps/mobile-showcase — Expo gallery of @flama/design-system-mobile",
      "identifiers": ["apps/mobile-showcase", "@flama/mobile-showcase"],
      "paths": ["apps/mobile-showcase"]
    },
    "mcp": {
      "title": "MCP server",
      "summary": "apps/mcp — Model Context Protocol server (stdio + Streamable HTTP) over the API",
      "identifiers": ["apps/mcp", "@flama/mcp", "flama-mcp"],
      "paths": ["apps/mcp"]
    },
    "runner": {
      "title": "Go runner service",
      "summary": "apps/runner + packages/go/* — Go service template (REST + WS, API keys) the API delegates long-lived work to",
      "identifiers": [
        "apps/runner",
        "@flama/runner",
        "packages/go",
        "@flama/go-",
        "go.work",
        "golangci",
        "flama-runner",
        "RUNNER_"
      ],
      "paths": [
        "apps/runner",
        "packages/go",
        "go.work",
        ".golangci.yml",
        ".agents/rules/go.md",
        "helm/flama/templates/runner-deployment.yaml"
      ]
    },
    "e2e": {
      "title": "End-to-end tests",
      "summary": "e2e/ — Playwright suites against the running API and web app",
      "identifiers": ["@flama/e2e", "e2e/"],
      "paths": ["e2e"],
      "scripts": ["test:e2e"]
    },
    "helm": {
      "title": "Kubernetes Helm chart",
      "summary": "helm/ — chart for the Tier 2 (Kubernetes) deployment",
      "identifiers": ["helm/"],
      "paths": ["helm"]
    },
    "organizations": {
      "title": "Organizations (teams)",
      "summary": "Multi-tenancy: organizations, members, invitations, workspaces and access grants, and the onboarding that creates the first organization",
      "identifiers": [
        "apps/api/src/organizations",
        "OrganizationsModule",
        "organizationPlugin",
        "withActiveOrganization",
        "ORGANIZATION_RESOURCES",
        "AccessGrantOrmEntity",
        "SCOPE_RESOLVER_PROVIDER",
        "useOrganizations",
        "WorkspaceGate",
        "organizationClientPlugin",
        "features/organizations",
        "@flama/frontend-consumer/organizations",
        "seedOrganization",
        "AccessGrantMapper"
      ],
      "paths": [
        "apps/api/src/organizations",
        "apps/api/src/auth/infrastructure/organization-plugin.config.ts",
        "apps/api/src/auth/infrastructure/invitation-url.util.ts",
        "apps/api/src/auth/__tests__/invitation-url.util.spec.ts",
        "apps/api/src/authz/application",
        "apps/api/src/authz/commands",
        "apps/api/src/authz/database",
        "apps/api/src/authz/decorators",
        "apps/api/src/authz/interceptors",
        "apps/api/src/authz/queries/find-access-grants",
        "apps/api/src/authz/domain/access-grant.entity.ts",
        "apps/api/src/authz/domain/access-grant.errors.ts",
        "apps/api/src/authz/dtos/access-grant.response.dto.ts",
        "apps/api/src/authz/authz.di-tokens.ts",
        "apps/api/src/authz/access-grant.mapper.ts",
        "apps/api/src/database/seed-organization.ts",
        "apps/mcp/src/tools/organizations.tools.ts",
        "apps/mcp/src/tools/workspaces.tools.ts",
        "apps/mobile/app/onboarding.tsx",
        "apps/mobile/features/organizations",
        "apps/web/src/features/organizations",
        "apps/web/src/routes/_auth/accept-invitation.tsx",
        "apps/web/src/routes/_auth/onboarding.tsx",
        "e2e/support/organizations.ts",
        "e2e/tests/api/organization-membership.spec.ts",
        "e2e/tests/web/invitation-acceptance.spec.ts",
        "e2e/tests/web/onboarding.spec.ts",
        "e2e/tests/web/organization-settings.spec.ts",
        "packages/auth/src/organization-client.ts",
        "packages/auth/src/organization-options.ts",
        "packages/frontend/consumer/src/modules/organizations",
        "packages/frontend/consumer/src/react/organizations.queries.ts",
        "packages/frontend/consumer/src/react/__tests__/organizations.create.spec.tsx",
        "packages/frontend/consumer/src/react/__tests__/organizations.invitations.spec.tsx",
        "packages/frontend/consumer/src/react/__tests__/organizations.queries.spec.ts",
        "packages/frontend/consumer/src/react/__tests__/query-keys.spec.ts"
      ],
      "json": [
        {
          "file": "packages/frontend/consumer/package.json",
          "path": ["exports"],
          "set": {
            "./organizations": {
              "types": "./dist/react/organizations.queries.d.ts",
              "import": "./dist/react/organizations.queries.js"
            }
          }
        }
      ],
      "regenerate": ["generate:api-client", "generate:openapi"]
    }
  },
  "shared": {
    "packages/frontend/design-system/web": {
      "identifiers": ["packages/frontend/design-system/web", "@flama/design-system-web"],
      "neededBy": ["web", "web-showcase"]
    },
    "packages/frontend/design-system/mobile": {
      "identifiers": ["packages/frontend/design-system/mobile", "@flama/design-system-mobile"],
      "neededBy": ["mobile", "mobile-showcase"]
    },
    "packages/frontend/core": {
      "identifiers": ["packages/frontend/core", "@flama/frontend-core"],
      "neededBy": ["web", "mobile"]
    },
    "packages/frontend/consumer": {
      "identifiers": ["packages/frontend/consumer", "@flama/frontend-consumer"],
      "neededBy": ["web", "mobile"]
    },
    "packages/frontend/web": {
      "identifiers": ["packages/frontend/web", "@flama/frontend-web"],
      "neededBy": ["web"]
    },
    "packages/frontend/mobile": {
      "identifiers": ["packages/frontend/mobile", "@flama/frontend-mobile"],
      "neededBy": ["mobile"]
    },
    "packages/frontend/api-client": {
      "identifiers": ["packages/frontend/api-client", "@flama/api-client"],
      "neededBy": ["web", "mobile"],
      "scripts": ["generate:api-client"]
    },
    "scripts/check-bundle-size.mjs": {
      "identifiers": ["check-bundle-size", "check:bundle"],
      "neededBy": ["web"],
      "scripts": ["check:bundle"]
    },
    "packages/tsconfig/tsconfig.expo.json": {
      "$comment": "Everything Expo leaves in the kept apps: the Better Auth expo plugin in apps/api, the EXPO_PUBLIC_* pass-through in turbo.json, the react-native override.",
      "identifiers": ["tsconfig.expo", "EXPO_PUBLIC_", "@better-auth/expo", "react-native"],
      "neededBy": ["mobile", "mobile-showcase"],
      "json": [
        {
          "file": "turbo.json",
          "path": ["tasks", "build", "env"],
          "remove": ["EXPO_PUBLIC_*"]
        },
        {
          "file": "package.json",
          "path": ["pnpm", "overrides"],
          "set": {
            "react-native": "0.86.3"
          }
        },
        {
          "file": "apps/api/package.json",
          "path": ["dependencies"],
          "set": {
            "@better-auth/expo": "^1.6.25"
          }
        },
        {
          "file": "biome.json",
          "path": ["files", "includes"],
          "remove": ["!**/.expo"]
        }
      ]
    },
    "scripts/check-frontend-structure.mjs": {
      "identifiers": ["check-frontend-structure", "check:structure"],
      "neededBy": ["web", "mobile"],
      "scripts": ["check:structure"]
    },
    "scripts/scaffold-feature.mjs": {
      "identifiers": ["scaffold-feature.mjs"],
      "neededBy": ["web", "mobile"]
    },
    ".agents/skills/scaffold-feature": {
      "identifiers": [".agents/skills/scaffold-feature", "/scaffold-feature"],
      "neededBy": ["web", "mobile"]
    },
    "packages/tsconfig/depcruise/frontend-app.cjs": {
      "identifiers": ["depcruise/frontend-app"],
      "neededBy": ["web", "mobile"]
    },
    "packages/tsconfig/depcruise/frontend-kit.cjs": {
      "identifiers": ["depcruise/frontend-kit"],
      "neededBy": ["web", "mobile"]
    }
  }
}
