{
  "name": "@flama/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "pnpm run routes && tsc -b && vite build",
    "routes": "node scripts/generate-routes.mjs",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "lint:design": "oxlint -c ../../packages/frontend/design-system/web/oxlint.design.json src",
    "clean": "rimraf dist .turbo node_modules",
    "arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@flama/api-client": "workspace:*",
    "@flama/auth": "workspace:*",
    "@flama/design-system-web": "workspace:*",
    "@flama/frontend-consumer": "workspace:*",
    "@flama/frontend-core": "workspace:*",
    "@flama/frontend-web": "workspace:*",
    "@flama/react-hooks": "workspace:*",
    "@flama/shared": "workspace:*",
    "@flama/translations": "workspace:*",
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "better-auth": "^1.7.12",
    "i18next": "^26.5.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "nuqs": "^2.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.1",
    "toqr": "0.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@flama/tsconfig": "workspace:^",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "^1.167.45",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "0.152.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "singletons": [
    "react",
    "react-dom",
    "@tanstack/react-query",
    "@tanstack/react-router"
  ]
}
