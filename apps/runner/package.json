{
  "name": "@flama/runner",
  "version": "0.1.0",
  "private": true,
  "description": "Go service template: REST + WebSocket, API-key and service-token auth, hexagonal modules",
  "scripts": {
    "build": "go build -trimpath -o dist/runner ./cmd/server",
    "dev": "go run ./cmd/server",
    "lint": "golangci-lint run ./...",
    "test": "go test -count=1 ./...",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@flama/go-auth": "workspace:*",
    "@flama/go-config": "workspace:*",
    "@flama/go-core": "workspace:*",
    "@flama/go-health": "workspace:*",
    "@flama/go-httpx": "workspace:*",
    "@flama/go-ws": "workspace:*"
  }
}
