{
  "name": "@flama/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "tsc -b && node scripts/build.mjs",
    "zip": "node scripts/store-zip.mjs",
    "keygen": "node scripts/keygen.mjs",
    "test": "vitest run --passWithNoTests && node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "lint": "biome check src/ scripts/",
    "lint:design": "oxlint -c ../../packages/frontend/design-system/web/oxlint.design.json src",
    "clean": "rimraf dist .turbo node_modules",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@flama/api-client": "workspace:*",
    "@flama/auth": "workspace:*",
    "@flama/design-system-web": "workspace:*",
    "@flama/frontend-consumer": "workspace:*",
    "@flama/frontend-core": "workspace:*",
    "@flama/frontend-web": "workspace:*",
    "@flama/react-hooks": "workspace:*",
    "@flama/shared": "workspace:*",
    "@flama/translations": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "better-auth": "^1.6.25",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "nuqs": "^2.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@flama/tsconfig": "workspace:^",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.1.0",
    "jsdom": "^30.0.1",
    "oxc-transform-react": "0.145.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
