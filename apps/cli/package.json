{
  "name": "@flama/cli",
  "version": "0.2.0",
  "private": true,
  "description": "Command-line interface for administering a Flama deployment",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "flama": "./dist/bin/flama.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/bin/flama.js",
    "lint": "biome check src/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flama/shared": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@flama/config": "workspace:^",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
