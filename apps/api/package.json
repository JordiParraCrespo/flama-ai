{
  "name": "@flama/api",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome check src/",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typeorm": "TS_NODE_PROJECT=tsconfig.typeorm.json typeorm-ts-node-commonjs",
    "migration:generate": "pnpm typeorm migration:generate -d src/config/data-source.ts",
    "migration:run": "pnpm typeorm migration:run -d src/config/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/config/data-source.ts",
    "generate:openapi": "pnpm exec nest build && OPENAPI_GENERATION=true BETTER_AUTH_SECRET=\"${BETTER_AUTH_SECRET:-openapi-generation-only}\" node dist/generate-openapi.js && biome check --write openapi.json",
    "seed": "TS_NODE_PROJECT=tsconfig.typeorm.json ts-node src/database/seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.12",
    "@flama/auth": "workspace:*",
    "@flama/backend-authz": "workspace:*",
    "@flama/backend-cache": "workspace:*",
    "@flama/backend-core": "workspace:*",
    "@flama/backend-ddd": "workspace:*",
    "@flama/backend-email": "workspace:*",
    "@flama/backend-i18n": "workspace:*",
    "@flama/backend-queue": "workspace:*",
    "@flama/backend-storage": "workspace:*",
    "@flama/env": "workspace:*",
    "@flama/shared": "workspace:*",
    "@flama/translations": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/cqrs": "^12.1.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.12",
    "bullmq": "^6.4.0",
    "class-transformer": "^0.5.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "oxide.ts": "^1.1.0",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@flama/tsconfig": "workspace:^",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.7.0",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  }
}
