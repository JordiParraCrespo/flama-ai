{
  "compilerOptions": {
    "module": "node20",
    "moduleResolution": "node16",
    "target": "ES2022",
    "rootDir": ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "resolveJsonModule": true
  },
  "ts-node": {
    "transpileOnly": true
  }
}
