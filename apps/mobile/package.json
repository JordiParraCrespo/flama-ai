{
  "name": "@flama/mobile",
  "version": "0.1.2",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "lint": "biome check app/ features/ lib/ app.config.ts && tsc --noEmit",
    "lint:design": "oxlint -c ../../packages/frontend/design-system/mobile/oxlint.design.json app features lib",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf .expo node_modules",
    "postinstall": "npx tailwindcss -i ./global.css -o ./node_modules/.cache/nativewind/global.css",
    "arch": "depcruise app features lib --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.12",
    "@expo/metro-runtime": "~58.0.15",
    "@flama/api-client": "workspace:*",
    "@flama/auth": "workspace:*",
    "@flama/design-system-mobile": "workspace:*",
    "@flama/env": "workspace:*",
    "@flama/frontend-consumer": "workspace:*",
    "@flama/frontend-core": "workspace:*",
    "@flama/frontend-mobile": "workspace:*",
    "@flama/shared": "workspace:*",
    "@flama/translations": "workspace:*",
    "@gorhom/bottom-sheet": "github:KaikuLabs/react-native-bottom-sheet#a7ef2476b8eeb1bb6861c733571d246a29e73bac",
    "@gorhom/portal": "github:KaikuLabs/react-native-portal#937b0b3a86a7126ec0294a5159372c0810dccf0d",
    "@hookform/resolvers": "^6.0.0",
    "@legendapp/list": "3.6.0",
    "@react-navigation/native": "^7.5.1",
    "@rn-primitives/portal": "1.5.3",
    "@rn-primitives/slot": "1.5.2",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "better-auth": "^1.7.12",
    "expo": "58.0.17",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "i18next": "^26.5.5",
    "intl-pluralrules": "2.0.1",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.1",
    "react-native": "0.88.0",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nano-icons": "1.0.1",
    "react-native-nitro-fetch": "1.9.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-root-siblings": "5.0.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@flama/tsconfig": "workspace:^",
    "@types/react": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.7.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-fetch"
        ]
      }
    },
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  }
}
