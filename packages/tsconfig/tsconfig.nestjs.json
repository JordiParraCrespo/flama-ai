{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "node20",
    "moduleResolution": "node16",
    "target": "ES2022",
    "outDir": "./dist",
    "baseUrl": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "noImplicitAny": true,
    "ignoreDeprecations": "6.0"
  }
}
