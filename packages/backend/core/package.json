{
  "name": "@flama/backend-core",
  "version": "0.2.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flama/backend-ddd": "workspace:*",
    "@flama/shared": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "@prometheus-io/client": "^0.16.1",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@flama/tsconfig": "workspace:^",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
