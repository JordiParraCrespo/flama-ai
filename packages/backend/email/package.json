    "@react-email/render": "^2.2.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@flama/tsconfig": "workspace:^",
    "@types/react": "19.3.0",
    "react-dom": "19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
