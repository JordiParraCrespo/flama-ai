{
  "name": "@flama/react-hooks",
  "version": "0.1.0",
  "private": true,
  "description": "Generic React hooks with no DOM, React Native or product in them: useControlled, useDebouncedValue, useDebouncedCallback, useNow.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@flama/tsconfig": "workspace:^",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
