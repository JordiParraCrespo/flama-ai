{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    // React Native 0.88 types its strict API by default; NativeWind's
    // `className` augmentation targets the legacy types this condition selects.
    "customConditions": ["react-native-legacy-deep-imports"],
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"]
}
