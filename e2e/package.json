{
  "name": "@flama/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:api": "playwright test --project=api",
    "e2e:web": "playwright test --project=web",
    "e2e:ratelimit": "RUN_RATE_LIMIT=1 playwright test --project=api --workers=1 --grep @ratelimit",
    "lint": "biome check .",
    "report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@flama/env": "workspace:*"
  }
}
