# ==============================================================================
# Flama — environment configuration
#
# There is ONE `.env`, at the root of the repo, and this file is its
# documentation. Copy it to get started:
#
#   cp .env.example .env
#
# The rules that keep it honest:
#   - Every variable the repo reads is in this file, with a note on what it
#     does; nothing that is not read is in it.
#   - If you add a variable, add it here with a note. Never add a per-package
#     `.env` — `@flama/env` (packages/env) and Vite's `envDir` only look here.
#   - Real environment variables always win over this file. `@flama/env` never
#     overwrites a value already in `process.env`, which is what makes the same
#     code correct in CI and in production containers.
#   - `.env.local` (gitignored) overrides `.env` for machine-local tweaks.
#
# ⚠ Footgun: `vercel env pull` writes `.env.local`, which overrides `.env` —
#   silently pointing local development at whatever that Vercel project uses
#   (e.g. the production database). Check `.env.local` first when values seem
#   to come from nowhere.
#
# ⚠ `VITE_*` and `EXPO_PUBLIC_*` values are baked into the client bundles at
#   build time and are PUBLIC. Never put a secret in them.
# ==============================================================================

# ------------------------------------------------------------------------------
# API (apps/api)
# ------------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
# Port the API listens on
PORT=3001
# Public URL of the web app (CORS, trusted origin, billing redirect fallbacks)
FRONTEND_URL=http://localhost:3000
# Base of the RFC 7807 `type` URIs in error responses (documents the catalog)
ERROR_TYPE_BASE_URL=https://flama.dev/errors

# Better Auth
# Secret used to sign sessions. Generate a strong one: `openssl rand -base64 32`
# Required — the app refuses to boot without it. Optional features (OAuth,
# Stripe, S3, SMTP/Resend) are the opposite: a missing key just disables the
# feature; check GET /health/capabilities to see what a deployment can do.
BETTER_AUTH_SECRET=change-me-in-production
# Public base URL of the API (used to build OAuth callback URLs; its protocol
# also decides whether session cookies are marked Secure)
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated user ids granted break-glass super-admin access via the
# Better Auth admin plugin (leave empty normally)
BETTER_AUTH_ADMIN_USER_IDS=
# Mobile deep-link scheme. Read by BOTH the API (trusted origin `${scheme}://`)
# and apps/mobile/app.config.ts (the app's `scheme`) — one variable, no drift.
MOBILE_SCHEME=flama

# Database (Postgres — `pnpm docker:up` starts one with these defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=flama
DB_PASSWORD=flama
DB_DATABASE=flama

# Redis (cache + BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Provider: console | nodemailer | resend
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@flama.dev

# SMTP (only when EMAIL_PROVIDER=nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend (only when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Storage Provider: local | s3
STORAGE_PROVIDER=local
# Directory for uploads when STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# S3 (only when STORAGE_PROVIDER=s3; also works with Hetzner Object Storage,
# MinIO, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=flama
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OAuth - Google (optional — leave unset to disable Google sign-in)
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (optional — leave unset to disable GitHub sign-in)
# Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe billing (optional — billing endpoints return BILLING_001 until set)
# Secret API key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret for POST /api/v1/billing/webhook (stripe listen / dashboard)
STRIPE_WEBHOOK_SECRET=
# Optional default redirect URLs (per-request overridable); default to ${FRONTEND_URL}/billing
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# OPENAPI_GENERATION is read by apps/api but set automatically by
# `pnpm generate:openapi` (boots the module graph without a database).
# Never set it yourself.

# ------------------------------------------------------------------------------
# Web (apps/web) — VITE_* values are public and baked in at build time
# ------------------------------------------------------------------------------

# Leave empty in development: the Vite dev server proxies `/api` to the API
# (http://localhost:3001), keeping web and API same-origin so the session
# cookie is sent with every request. Set this only when the API is served from
# a different origin behind a shared domain in production.
VITE_API_URL=

# Analytics (PostHog)
# Leave the key empty to disable analytics entirely — the app falls back to a
# no-op client, the SDK is never downloaded, and every feature flag reads as
# off. Set it to your project key to enable.
VITE_POSTHOG_KEY=
# Defaults to the EU cloud region. Use https://us.i.posthog.com for a US
# project, or your own origin when self-hosting.
VITE_POSTHOG_HOST=

# ------------------------------------------------------------------------------
# Mobile (apps/mobile) — EXPO_PUBLIC_* values are public and baked in at build
# time (apps/mobile/app.config.ts loads this file before Metro bundles)
# ------------------------------------------------------------------------------

# Use http://localhost:3001 for the iOS simulator. On a physical device or
# Android emulator, point this at your machine's LAN IP (e.g. http://192.168.x.x:3001)
# and add that origin to the API's trusted origins if needed.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Analytics (PostHog) — same semantics as the VITE_ pair above
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# ------------------------------------------------------------------------------
# MCP server (apps/mcp)
# ------------------------------------------------------------------------------

# Base URL of the Flama API the MCP server talks to
FLAMA_API_URL=http://localhost:3001
# API token for the stdio entrypoint (`flama tokens create`); the HTTP
# entrypoint takes a credential per request instead. Also read by the CLI as an
# override for the active profile's token.
FLAMA_API_TOKEN=
# Port for the Streamable HTTP entrypoint. MCP_PORT wins over PORT so the MCP
# server never collides with the API's PORT above (defaults to 3005).
MCP_PORT=3005
# Request timeout in milliseconds (default 30000)
FLAMA_TIMEOUT_MS=
# `ttlMs` advertised on tools/list (0 disables client caching of the list)
FLAMA_TOOLS_CACHE_TTL_MS=
# Comma-separated origins allowed to reach the HTTP entrypoint from a browser
# (empty disables cross-origin access)
FLAMA_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# CLI (apps/cli) — normally configured via profiles (`flama config`), not env.
# These are per-invocation overrides read from the real environment:
#   FLAMA_CONFIG   — path to the config file (default: XDG config dir)
#   FLAMA_PROFILE  — profile to use for this invocation
#   FLAMA_API_URL / FLAMA_API_TOKEN — override the profile's URL/token
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Docker Compose (docker/docker-compose.prod.yml) — read at `docker compose`
# time for image/DB interpolation, not by application code
# ------------------------------------------------------------------------------

# Images to deploy (CI pushes to GHCR)
API_IMAGE=
WEB_IMAGE=
DOCS_IMAGE=
