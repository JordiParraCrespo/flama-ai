# ==============================================================================
# Flama — environment configuration
#
# There is ONE `.env`, at the root of the repo, and this file is its
# documentation. Copy it to get started:
#
#   cp .env.example .env
#
# The rules that keep it honest:
#   - Every variable the repo reads is in this file, with a note on what it
#     does; nothing that is not read is in it.
#   - If you add a variable, add it here with a note. Never add a per-package
#     `.env` — `@flama/env` (packages/env) and Vite's `envDir` only look here.
#   - Real environment variables always win over this file. `@flama/env` never
#     overwrites a value already in `process.env`, which is what makes the same
#     code correct in CI and in production containers.
#   - `.env.local` (gitignored) overrides `.env` for machine-local tweaks.
#
# ⚠ Footgun: `vercel env pull` writes `.env.local`, which overrides `.env` —
#   silently pointing local development at whatever that Vercel project uses
#   (e.g. the production database). Check `.env.local` first when values seem
#   to come from nowhere.
#
# ⚠ `VITE_*` and `EXPO_PUBLIC_*` values are baked into the client bundles at
#   build time and are PUBLIC. Never put a secret in them.
# ==============================================================================

# ------------------------------------------------------------------------------
# API (apps/api)
# ------------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
# Port the API listens on
PORT=3001
# Public URL of the web app (CORS, trusted origin, redirect fallbacks)
FRONTEND_URL=http://localhost:3000
# flama:plugins api-urls
# Base of the RFC 7807 `type` URIs in error responses (documents the catalog)
ERROR_TYPE_BASE_URL=https://flama.dev/errors
# Number of reverse-proxy hops in front of the API (Express `trust proxy`).
# 0 = direct connection. Behind nginx/an ingress set it to the hop count so
# `req.ip` is the real client — the rate limiter keys on it, and API-token IP
# allowlists and audit logs record it.
TRUST_PROXY=0

# Better Auth
# Secret used to sign sessions. Generate a strong one: `openssl rand -base64 32`
# Required — the app refuses to boot without it, and `pnpm docker:prod`
# refuses to start without this file or this value. Optional features (OAuth,
# SMTP/Resend) are the opposite: a missing key just disables the
# feature; check GET /health/capabilities to see what a deployment can do.
BETTER_AUTH_SECRET=change-me-in-production
# Public base URL of the API (used to build OAuth callback URLs; its protocol
# also decides whether session cookies are marked Secure)
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated user ids granted break-glass super-admin access via the
# Better Auth admin plugin (leave empty normally)
BETTER_AUTH_ADMIN_USER_IDS=
# Auth rate limiting (login/forgot-password/sign-up). On automatically in
# production; set to true to also enable it in a non-production deployment that
# faces the internet. Leave false in development/test so a local run or e2e
# suite that signs in repeatedly is not throttled.
AUTH_RATE_LIMIT_ENABLED=false
# flama:begin mobile
# Mobile deep-link scheme. Read by BOTH the API (trusted origin `${scheme}://`)
# and apps/mobile/app.config.ts (the app's `scheme`) — one variable, no drift.
MOBILE_SCHEME=flama
EXPO_PUBLIC_MOBILE_SCHEME=flama
# flama:end mobile
# flama:plugins admin-mobile

# Database (Postgres — `pnpm docker:up` starts one with these defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=flama
DB_PASSWORD=flama
DB_DATABASE=flama
# Log SQL queries at debug level (off by default — bound parameters are never logged)
DB_LOG_QUERIES=false
# Read once, by migration 1789000000000-TimestampsWithTimeZone: the IANA zone
# (e.g. Europe/Madrid) the old `timestamp` columns were written in. Leave it
# empty unless that migration refuses to run because the API and the database
# ran in different zones; it then reads every stored value in this zone.
TIMESTAMP_SOURCE_TIME_ZONE=
# Seed (development only). `pnpm --filter @flama/api seed` creates well-known
# admin/user accounts; override their passwords here so a shared database never
# gets the published defaults. Seeding refuses to run when NODE_ENV=production
# unless ALLOW_PRODUCTION_SEED=true (and then only with strong passwords set).
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
ALLOW_PRODUCTION_SEED=false

# Redis (cache + BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis password (optional). Set when Redis requires auth (`requirepass`);
# leave empty for an unauthenticated connection on a private network.
REDIS_PASSWORD=

# Email Provider: console | nodemailer | resend
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@flama.dev

# SMTP (only when EMAIL_PROVIDER=nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Resend (only when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Storage driver for uploads (avatars): one of the drivers
# apps/api/src/config/storage.config.ts lists. `local` writes them to disk.
STORAGE_PROVIDER=local
# Directory the local driver writes uploads to
UPLOAD_DIR=./uploads
# Absolute base the browser loads locally-stored files from (avatars). The API
# serves them under `${STORAGE_PUBLIC_URL}/uploads/...`, so this must be an
# origin the browser can reach the API at. Leave empty to default to
# BETTER_AUTH_URL (the API's own public URL); set it only when local files are
# fronted by a separate host/CDN. Only the local driver reads it.
STORAGE_PUBLIC_URL=

# OAuth - Google (optional — leave unset to disable Google sign-in)
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (optional — leave unset to disable GitHub sign-in)
# Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# flama:plugins api-integrations-env
# OPENAPI_GENERATION is read by apps/api but set automatically by
# `pnpm generate:openapi` (boots the module graph without a database).
# Never set it yourself.

# flama:begin web
# ------------------------------------------------------------------------------
# Web apps — VITE_* values are public and baked in at build time
# ------------------------------------------------------------------------------

# Leave empty in development: the Vite dev server proxies `/api` to the API
# (http://localhost:3001), keeping web and API same-origin so the session
# cookie is sent with every request. Set this only when the API is served from
# a different origin behind a shared domain in production.
VITE_API_URL=
# flama:end web
# flama:plugins web-env

# flama:begin mobile
# ------------------------------------------------------------------------------
# Mobile apps — EXPO_PUBLIC_* values are public and baked in at build time
# (each app's app.config.ts loads this file before Metro bundles)
# ------------------------------------------------------------------------------

# Use http://localhost:3001 for the iOS simulator. On a physical device or
# Android emulator, point this at your machine's LAN IP (e.g. http://192.168.x.x:3001)
# and add that origin to the API's trusted origins if needed.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Error reporting (Sentry). Empty disables the SDK. The native plugin still
# runs at prebuild; a missing DSN means nothing is sent.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# flama:end mobile
# flama:begin remote-config
# Remote config: a JSON document of tunables, merged over the defaults in
# apps/mobile/lib/remote-config.ts. Empty skips the fetch; the app runs on the
# defaults and on the last document it cached.
EXPO_PUBLIC_CONFIG_URL=

# flama:end remote-config
# flama:plugins mobile-env

# flama:plugins agent-env

# flama:plugins env

# ------------------------------------------------------------------------------
# Docker Compose (docker/docker-compose.prod.yml) — read at `docker compose`
# time for image/DB interpolation, not by application code. The prod stack
# also loads this whole file into the API container, so run it from the repo
# root with `--env-file .env` (`pnpm docker:prod`).
# ------------------------------------------------------------------------------

# Images to deploy (CI pushes to GHCR)
API_IMAGE=
# flama:begin web
WEB_IMAGE=
# flama:end web
# flama:plugins admin-web
# flama:plugins docs
