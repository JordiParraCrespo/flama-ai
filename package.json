{
  "name": "flama",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:design": "pnpm -r run lint:design",
    "arch": "turbo run arch",
    "format": "biome format --write .",
    "check": "biome check --write --unsafe .",
    "check:biome-plugins": "biome lint --error-on-warnings biome-plugins/fixtures",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:hooks": "node --test .agents/hooks/git-guard.test.mjs",
    "check:api-structure": "node scripts/check-api-structure.mjs && node --test scripts/check-api-structure.test.mjs",
    "check:public-api": "node scripts/check-backend-public-api.mjs",
    "check:structure": "node scripts/check-frontend-structure.mjs && node --test scripts/check-frontend-structure.test.mjs",
    "check:singletons": "node --test scripts/check-singletons.test.mjs && node scripts/check-singletons.mjs",
    "check:compiler": "node --test scripts/check-react-compiler.test.mjs && node scripts/check-react-compiler.mjs",
    "ci:local": "node scripts/ci/local.mjs",
    "monitoring:up": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/monitoring/compose.mjs up -d",
    "monitoring:down": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/monitoring/compose.mjs down",
    "test:scripts": "node --test scripts/lib/*.test.mjs scripts/plugins/*.test.mjs scripts/ci/*.test.mjs scripts/check-backend-public-api.test.mjs",
    "plugin:add": "node scripts/plugins/plugin.mjs add",
    "plugin:remove": "node scripts/plugins/plugin.mjs remove",
    "plugin:list": "node scripts/plugins/plugin.mjs list",
    "starter:init": "node scripts/starter/init.mjs",
    "starter:prune": "node scripts/starter/prune.mjs",
    "starter:check": "node scripts/starter/prune.mjs --check && node --test scripts/starter/*.test.mjs",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @flama/e2e e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:prod": "docker compose --env-file .env -f docker/docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose --env-file .env -f docker/docker-compose.prod.yml down",
    "generate:openapi": "pnpm --filter @flama/api generate:openapi",
    "generate:api-client": "pnpm generate:openapi && pnpm --filter @flama/api-client generate",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@shadcn/lint": "0.2.3",
    "oxlint": "1.89.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "19.3.0",
      "react-native": "0.88.0",
      "@tanstack/query-core": "5.104.5",
      "@tanstack/react-query": "5.104.5",
      "@nestjs/swagger": "12.0.3"
    }
  }
}
